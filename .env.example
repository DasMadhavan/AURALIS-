# ELEVENLABS_API_KEY: Optional API key for direct ElevenLabs v1 API calls (/v1/text-to-speech, /v1/voices/add, /v1/sound-generation).
# When not provided, the server automatically synthesizes studio-grade 24kHz WAV audio via the built-in acoustic engine and Gemini TTS.
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"

# NVIDIA_API_KEY: Optional NVIDIA NIM API key (nvapi-...) for /api/nvidia/script-director (integrate.api.nvidia.com/v1).
# Configure via the Secrets panel in AI Studio.
NVIDIA_API_KEY="YOUR_NVIDIA_NIM_API_KEY"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
